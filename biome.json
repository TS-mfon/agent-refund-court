{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedImports": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "preset": "none"
    }
  },
  "formatter": {
    "enabled": false
  }
}
